/* KiK OS Kernel Linker Script */

ENTRY(_start)

SECTIONS
{
    . = 0x100000;  /* Load at 1MB */

    .text : {
        *(.text .text.*)
    }

    .rodata : {
        *(.rodata .rodata.*)
    }

    .data : {
        *(.data .data.*)
    }

    .bss : {
        *(.bss .bss.*)
        *(COMMON)
    }

    /DISCARD/ : {
        *(.eh_frame)
        *(.note.*)
    }
}